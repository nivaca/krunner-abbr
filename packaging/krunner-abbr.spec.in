# Generated by build_rpm.py from packaging/krunner-abbr.spec.in; edit that file instead.
Name:           krunner-abbr
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        KRunner plugin for expanding abbreviations
License:        GPL-3.0-or-later
URL:            https://github.com/nivaca/krunner-abbr
Source0:        %{name}-%{version}.tar.gz
BuildArch:      noarch

Requires:       python3 >= 3.11
Requires:       python3-dbus
Requires:       python3-gobject
Requires:       plasma-workspace
Recommends:     python3-pyside6
Recommends:     wl-clipboard
Recommends:     kdialog
Recommends:     python3-pyyaml
Suggests:       ydotool

%description
Type a keyword and an abbreviation in KRunner and get the expansion on the
clipboard, or pasted in the window you were using: dates in any format and
language, clipboard transformations, small forms, links that open in the
browser, Latin and Spanish helpers, and more.

%prep
%autosetup

%build
# nothing to build: plain Python

%install
install -d %{buildroot}%{_datadir}/%{name}
install -m 644 krunner_abbr*.py abbreviations.toml %{buildroot}%{_datadir}/%{name}/
install -Dm 755 packaging/krunner-abbr %{buildroot}%{_bindir}/%{name}
install -Dm 644 packaging/krunner-abbr.desktop \
    %{buildroot}%{_datadir}/krunner/dbusplugins/krunner-abbr.desktop
sed -i 's/__VERSION__/%{version}/' %{buildroot}%{_datadir}/krunner/dbusplugins/krunner-abbr.desktop
install -Dm 644 packaging/io.github.nivaca.AbbrKRunner.service \
    %{buildroot}%{_datadir}/dbus-1/services/io.github.nivaca.AbbrKRunner.service

%files
%license LICENSE
%doc README.md
%{_bindir}/%{name}
%{_datadir}/%{name}/
%{_datadir}/krunner/dbusplugins/krunner-abbr.desktop
%{_datadir}/dbus-1/services/io.github.nivaca.AbbrKRunner.service

%changelog
@CHANGELOG@
